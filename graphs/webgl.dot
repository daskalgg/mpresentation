// The WebGL rasterization pipeline and how we repurpose it for ray-tracing
digraph webgl {
    graph [rankdir=LR, bgcolor="transparent", nodesep=0.3, ranksep=0.45, dpi=200, newrank=true];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13,
           color="#33415c", fillcolor="#eef2f8", penwidth=1.3];
    edge  [color="#33415c", arrowsize=0.7, penwidth=1.2];

    // subgraph cluster_ours {
    //     label="Our use: GPGPU ray-tracing"; fontname="Helvetica-Bold"; fontsize=14;
    //     style="rounded,dashed"; color="#2b7a3d";
    //     node [fillcolor="#e3f1e6", color="#2b7a3d"];
    //     b1 [label="2 triangles\n+ scene texture"];
    //     b2 [label="Vertex shader\n(full-screen quad)"];
    //     b3 [label="Fragment shader\n(trace 1 ray per pixel)"];
    //     b4 [label="Float texture\n(energy, distance)"];
    //     b1 -> b2 -> b3 -> b4;
    // }

    subgraph cluster_normal {
        label="Typical use: rasterization"; fontname="Helvetica-Bold"; fontsize=14;
        style="rounded,dashed"; color="#8899aa";
        a1 [label="Mesh\n(vertices)"];
        a2 [label="Vertex shader\n(project to 2D)"];
        a3 [label="Fragment shader\n(color per pixel)"];
        a4 [label="Image"];
        a1 -> a2 -> a3 -> a4;
    }
    {rank=same; a1}
}
