// Linkwitz-Riley crossover tree that merges the 8 band-limited DRIRs.
// Crossover frequency of each node = sqrt(f_low * f_high).
digraph lrtree {
    graph [rankdir=TB, bgcolor="transparent", nodesep=0.25, ranksep=0.5, dpi=200];
    node  [fontname="Helvetica", fontsize=13, style="rounded,filled", penwidth=1.3];
    edge  [color="#33415c", arrowsize=0.6, penwidth=1.1];

    node [shape=box, fillcolor="#fbeedd", color="#a35a00"];
    b1 [label="125 Hz"]; b2 [label="250 Hz"]; b3 [label="500 Hz"]; b4 [label="1 kHz"];
    b5 [label="2 kHz"];  b6 [label="4 kHz"];  b7 [label="8 kHz"];   b8 [label="16 kHz"];

    node [shape=ellipse, fillcolor="#eef2f8", color="#33415c"];
    x1 [label="Crossover @ 177 Hz"]; x2 [label="Crossover @ 707 Hz"];
    x3 [label="Crossover @ 2.8 kHz"]; x4 [label="Crossover @ 11.3 kHz"];
    y1 [label="Crossover @ 354 Hz"]; y2 [label="Crossover @ 5.7 kHz"];
    z  [label="Crossover @ 1.4 kHz"];

    out [shape=box, fillcolor="#33415c", fontcolor="white", color="#33415c",
         label="Full-band ambisonic DRIR"];

    {b1 b2} -> x1; {b3 b4} -> x2; {b5 b6} -> x3; {b7 b8} -> x4;
    {x1 x2} -> y1; {x3 x4} -> y2;
    {y1 y2} -> z -> out;
}
